# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# testing
/coverage

# production
/build
/dist

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
/.idea/

# monitor pipeline: cloned frontends
/monitor/repos/
/monitor/probe/out/
.env.probe

# research/: reproducible checks (results and HTTP cache are regenerated by the scripts)
/research/out/
/research/.cache*/
# Russian copies of the research docs: kept locally, the repository is English-only
/research/*_RU.md
/research/.env
__pycache__/
