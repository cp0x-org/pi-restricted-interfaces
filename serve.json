{
  "cleanUrls": true,
  "trailingSlash": false,
  "directoryListing": false,
  "headers": [
    { "source": "assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] }
  ]
}
