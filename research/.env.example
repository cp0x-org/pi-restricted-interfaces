# Copy to research/.env (git-ignored). Read by check_live.py and check_api.py; real environment variables win.
# Without research/.env the scripts fall back to the project's .env.probe (same variable names as monitor/scripts/probe.py).

# Proxy with country targeting for check_live.py (and for check_bundle.py / check_docs.py when a site is unreachable
# from this machine). {cc} = lower-case ISO code, {CC} = upper-case.
#
# Decodo (ex-Smartproxy) residential, the provider used for the catalog. The dashboard shows an endpoint such as
#   gate.decodo.com:10001:LOGIN:PASSWORD   (host:port:user:password)
# Port 10001 (and up) is a sticky session with a random country: the country cannot be chosen there. For country
# targeting use port 7000 and put the country into the user name, "user-LOGIN-country-{cc}":
# {session} becomes one random id per country and run, so a sticky session keeps one exit IP for the vantage check
# and every request (without it port 7000 rotates the IP on every request):
PROBE_PROXY_URL=http://user-LOGIN-country-{cc}-session-{session}-sessionduration-30:PASSWORD@gate.decodo.com:7000
# Regions: US states as user-LOGIN-country-us-state-us_new_york; Canadian provinces through a city, e.g.
# user-LOGIN-country-ca-city-toronto (Ontario):
# PROBE_PROXY_URL_US_NY=http://user-LOGIN-country-us-state-us_new_york-session-{session}-sessionduration-30:PASSWORD@gate.decodo.com:7000
# PROBE_PROXY_URL_CA_ON=http://user-LOGIN-country-ca-city-toronto-session-{session}-sessionduration-30:PASSWORD@gate.decodo.com:7000

# Other providers, same idea (copy the exact string from the provider's dashboard):
#   IPRoyal      http://LOGIN:PASSWORD_country-{cc}@geo.iproyal.com:12321
#   DataImpulse  http://LOGIN__cr.{cc}:PASSWORD@gw.dataimpulse.com:823
#   Oxylabs      http://customer-LOGIN-cc-{CC}:PASSWORD@pr.oxylabs.io:7777
# One country or region with its own string: PROBE_PROXY_URL_US_NY=...
PROBE_PROXY_TYPE=residential
# Countries of the live sweep and of monitor:probe (default: `default` of monitor/data/countries.json; groups
# popular, regions, sanctioned can be named), about 8 MB each per run:
# PROBE_COUNTRIES=US,GB,DE
PROBE_TIMEOUT=40
# Special characters in the password must be URL-encoded: + -> %2B, @ -> %40, / -> %2F, : -> %3A
# Check one country by hand: curl -x 'http://user-LOGIN-country-us:PASSWORD@gate.decodo.com:7000' https://api.country.is/

# Ethereum RPC for the sanctions-oracle preflight in check_api.py (optional; default https://ethereum-rpc.publicnode.com)
# RPC_URL=https://eth.llamarpc.com
